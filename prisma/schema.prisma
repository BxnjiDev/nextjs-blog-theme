// Atlas portfolio intelligence data model.
//
// Design notes:
// - This schema is the system of record for Atlas's OWN analysis
//   (recommendations, risk scores, briefings, data-quality verdicts). It is
//   NOT a cache of brokerage truth — Account/Holding/Transaction/OpenOrder
//   rows are synced FROM the connected brokerage (Robinhood Agentic
//   Trading, via its MCP server) and should be treated as read-mostly
//   mirrors, not edited directly by app logic.
// - There is no order-placement path anywhere in this schema. An earlier
//   TradeProposal model (with a MANUAL_APPROVAL/AUTONOMOUS mode) was
//   removed in Phase 3.7 — it was never wired to anything, but its shape
//   (orderType/limitPrice/stopPrice, an AUTONOMOUS mode) was itself a risk
//   the phase's execution-boundary review flagged. ManualExecution is its
//   replacement for tracking trades: strictly a record of what the user
//   already did, reconciled against the next real Robinhood sync — never a
//   request Atlas acts on. See ARCHITECTURE.md's "Execution boundary"
//   section and lib/domain/executionReconciliation.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetClass {
  EQUITY
  ETF
  OPTION
  CRYPTO
  CASH
}

enum TradeSide {
  BUY
  SELL
}

enum TransactionSource {
  MANUAL
  AI_RECOMMENDED
  AUTONOMOUS
}

enum RecommendedAction {
  BUY_MORE
  HOLD
  REDUCE
  SELL
  WATCH
}

enum OpportunityCategory {
  UNDERVALUED
  EMERGING_TREND
  HIGH_CONVICTION
  IMPROVING_FUNDAMENTALS
  COMPOUNDER
}

enum AlertType {
  THESIS_CHANGE
  DRAWDOWN_10PCT
  EARNINGS_SURPRISE
  INSIDER_ACTIVITY
  CONTRACT_WIN
  LOST_CUSTOMER
  LIQUIDITY_CONCERN
  DEBT_CONCERN
  ACCOUNTING_CONCERN
  NEW_OPPORTUNITY
  BETTER_RISK_REWARD
  NEW_SEC_FILING
  CONCENTRATION_RISK
  RISK_SCORE_INCREASE
  MAJOR_NEGATIVE_NEWS
  UPCOMING_EARNINGS
  STALE_DATA
  GUIDANCE_CHANGE
}

enum StatementPeriodType {
  ANNUAL
  QUARTERLY
}

enum NotificationChannelType {
  EMAIL
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PatternConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ThesisChangeType {
  INITIAL
  THESIS_CHANGED
  CONVICTION_CHANGED
  RISK_CHANGED
  VALUATION_CHANGED
  RETURN_EXPECTATION_CHANGED
  ROUTINE_REVIEW_NO_CHANGE
}

enum MaterialityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ComparisonEdge {
  FAVORS_OPPORTUNITY
  FAVORS_HOLDING
  NEUTRAL
}

enum AlertSeverity {
  INFO
  WATCH
  URGENT
}

enum OrderType {
  MARKET
  LIMIT
  STOP
}

/// What the user actually did with a recommendation. ACCEPTED/
/// PARTIALLY_ACCEPTED are auto-detected by matching a synced Transaction
/// against a PENDING recommendation (lib/domain/recommendationDecisions.ts);
/// REJECTED/DEFERRED are explicit user actions (there's no way to infer
/// "I decided not to" from silence).
enum UserDecision {
  PENDING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  DEFERRED
}

enum ProviderCallOutcome {
  SUCCESS
  FAILURE
  FALLBACK
}

/// How a manually-recorded execution (ManualExecution — a trade the user
/// placed themselves in Robinhood, never something Atlas submitted)
/// compares against the real brokerage Transaction the next sync ingests.
/// Set by lib/domain/executionReconciliation.ts; never implies Atlas
/// caused, previewed, or approved the trade — only that it was told about
/// it and is checking its own record against reality.
enum ExecutionMatchStatus {
  PENDING
  MATCHED
  PARTIALLY_MATCHED
  UNMATCHED
  AMOUNT_MISMATCH
  QUANTITY_MISMATCH
  PRICE_MISMATCH
  TIMING_MISMATCH
}

/// Verdict from lib/domain/dataQualityGate.ts, evaluated BEFORE a
/// recommendation is generated. BLOCKED means no Recommendation row is
/// created at all for that symbol on that run (see DataQualityGateLog) —
/// Atlas never fabricates a recommendation just to have an answer.
enum DataQualityStatus {
  PASS
  PASS_WITH_WARNINGS
  BLOCKED
}

/// Outcome of one lib/domain/scheduler.ts job execution — the local
/// operational scheduler's run history (SchedulerRun), independent of the
/// ad hoc {ok,result,errors} JSON individual /api/jobs/* routes return.
enum SchedulerRunStatus {
  RUNNING
  SUCCESS
  WARNING
  FAILURE
  SKIPPED
}

/// A connected brokerage account (e.g. a Robinhood Agentic Trading account).
/// Populated by syncing from the brokerage integration, not hand-edited.
model Account {
  id                  String    @id @default(cuid())
  provider            String // e.g. "robinhood"
  externalId          String    @unique // brokerage account id
  cashBalance         Decimal   @default(0)
  buyingPower         Decimal   @default(0)
  lastSyncedAt        DateTime?
  /// Set by lib/domain/accountSync.ts when a sync payload identifies this
  /// as the $500 recommendation-only evaluation account (see
  /// lib/domain/evaluationConfig.ts). Drives the site-wide evaluation-mode
  /// banner — nothing else in the app branches on this flag.
  isEvaluationAccount Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  holdings         Holding[]
  transactions     Transaction[]
  openOrders       OpenOrder[]
  syncLogs         SyncLog[]
  manualExecutions ManualExecution[]
}

/// A current position, mirrored from the brokerage account.
model Holding {
  id           String     @id @default(cuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id])
  symbol       String
  name         String
  assetClass   AssetClass @default(EQUITY)
  sector       String?
  quantity     Decimal
  avgCostBasis Decimal
  /// Cumulative realized P&L as reported by the brokerage sync payload —
  /// Atlas has no independent way to compute this (it doesn't necessarily
  /// have full pre-Atlas transaction history), so it's taken as reported,
  /// not derived.
  realizedPnl  Decimal    @default(0)
  updatedAt    DateTime   @updatedAt

  recommendations Recommendation[]
  thesis          Thesis?

  @@unique([accountId, symbol])
  @@index([symbol])
}

/// Historical fills, mirrored from the brokerage account.
model Transaction {
  id         String            @id @default(cuid())
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id])
  symbol     String
  side       TradeSide
  quantity   Decimal
  price      Decimal
  source     TransactionSource @default(MANUAL)
  externalId String?           @unique // brokerage order/fill id
  executedAt DateTime

  manualExecution ManualExecution?

  @@index([symbol])
  @@index([executedAt])
}

/// End-of-day (or intraday) price ticks, used for performance charts and
/// benchmark comparisons. Backed by a market-data provider integration.
model PriceSnapshot {
  id         String   @id @default(cuid())
  symbol     String
  price      Decimal
  volume     BigInt?
  capturedAt DateTime

  @@index([symbol, capturedAt])
}

/// Portfolio value vs. S&P 500, tracked over time for the overview page and
/// performance-tracking metrics (CAGR, alpha, beta, Sharpe, drawdown).
model PerformanceSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @unique
  portfolioValue Decimal
  sp500Value     Decimal
  cashBalance    Decimal

  @@index([date])
}

/// Per-holding investment thesis, refreshed over time. Each new analysis
/// creates a new row rather than overwriting the last one, so "has the
/// thesis changed?" can be answered by diffing against `previousId`.
model Recommendation {
  id                     String                 @id @default(cuid())
  holdingId              String
  holding                Holding                @relation(fields: [holdingId], references: [id])
  symbol                 String
  thesis                 String
  thesisChanged          Boolean                @default(false)
  bullCase               String
  bearCase               String
  catalysts              String
  risks                  String
  fairValueOpinion       String?
  technicalTrend         String?
  institutionalSentiment String?
  confidenceScore        Int // 1-10
  action                 RecommendedAction
  /// What Atlas expects to happen and over what horizon — captured at
  /// generation time so the outcome-tracking/learning job has a stated
  /// prediction to grade against, not a retrofitted one.
  expectedOutcome        String                 @default("Not stated.")
  expectedTimeHorizon    String                 @default("Not stated.")
  /// Explainability: why now / why not / supporting & contradicting
  /// evidence / key assumptions / what would invalidate this call / how
  /// this compares to just holding cash or buying SPY — see
  /// lib/integrations/aiReasoning.ts's ExplainabilitySchema.
  explainability         Json?
  /// Deterministic position sizing (code-computed from confidence + the
  /// account's actual cash/total value at generation time — never an
  /// AI-invented number). Null for WATCH, where no size applies.
  proposedDollarAmount   Decimal?
  percentageOfPortfolio  Float?
  /// What the user did about this call — see UserDecision. ACCEPTED/
  /// PARTIALLY_ACCEPTED are set automatically by matching a later synced
  /// transaction; REJECTED/DEFERRED are set explicitly by the user.
  userDecision           UserDecision           @default(PENDING)
  userDecisionAt         DateTime?
  userDecisionNote       String?
  /// Per-source freshness/quality metadata captured at generation time
  /// (quote/fundamentals asOf + quality, filing count, news count) — lets
  /// the dashboard show exactly how current an analysis is.
  sourcesMeta            Json?
  /// The data-quality gate's verdict (lib/domain/dataQualityGate.ts) at
  /// generation time, denormalized here for fast display — PASS/
  /// PASS_WITH_WARNINGS only, since a BLOCKED verdict never produces a
  /// Recommendation row (see DataQualityGateLog for the full audit trail,
  /// including blocked attempts). Nullable only because recommendations
  /// created before this phase have no gate verdict on record.
  dataQualityStatus      DataQualityStatus?
  dataQualityChecks      Json?
  previousId             String?                @unique
  previous               Recommendation?        @relation("RecommendationHistory", fields: [previousId], references: [id])
  next                   Recommendation?        @relation("RecommendationHistory")
  outcome                RecommendationOutcome?
  manualExecutions       ManualExecution[]
  generatedAt            DateTime               @default(now())

  @@index([symbol, generatedAt])
  @@index([holdingId, generatedAt])
}

/// Candidates not currently held — the "Opportunities" surface.
model Opportunity {
  id              String                  @id @default(cuid())
  symbol          String
  name            String
  category        OpportunityCategory
  thesis          String
  confidenceScore Int // 1-10
  identifiedAt    DateTime                @default(now())
  dismissedAt     DateTime?
  comparisons     OpportunityComparison[]

  @@index([symbol])
}

/// Portfolio-level risk dashboard snapshot. Each factor is scored 1-100
/// (higher = riskier) so the UI can render a consistent gauge. Produced by
/// lib/jobs/generateRiskAssessment.ts from deterministic calculations (see
/// lib/domain/risk.ts) — `inputs` and `explanation` make every score
/// traceable back to the numbers that produced it.
model RiskAssessment {
  id                String   @id @default(cuid())
  concentrationRisk Int
  sectorRisk        Int
  volatilityRisk    Int
  betaRisk          Int
  drawdownRisk      Int
  valuationRisk     Int
  earningsRisk      Int
  regulatoryRisk    Int
  liquidityRisk     Int
  macroRisk         Int
  newsRisk          Int
  stalenessRisk     Int
  overallScore      Int
  previousScore     Int?
  /// Raw numeric inputs behind each component (top-3/top-5 exposure %,
  /// realized volatility, beta, max drawdown, HHI, etc.) — the "defensible
  /// calculation" audit trail.
  inputs            Json
  /// Per-component plain-English explanation of what drove that score.
  explanation       Json
  dataSourcesMeta   Json?
  notes             String?
  generatedAt       DateTime @default(now())

  @@index([generatedAt])
}

/// A generated morning briefing. Content sections are stored as structured
/// JSON so the page can render them without re-deriving from raw sources,
/// while still linking back to the Recommendation/RiskAssessment rows used.
model Briefing {
  id                String   @id @default(cuid())
  date              DateTime @unique
  portfolioSummary  Json
  marketRecap       Json
  opportunitiesNote String?
  riskAssessmentId  String?
  generatedAt       DateTime @default(now())
}

/// A news/filing/event item surfaced by the monitoring layer. `materiality`
/// is a 1-10 score used to decide whether it's worth surfacing at all
/// ("only notify when genuinely meaningful"). `dedupeKey` (headline+source
/// normalized, or URL) is how the news job avoids storing the same story —
/// including syndicated copies — twice.
model NewsItem {
  id               String           @id @default(cuid())
  symbol           String? // primary/first associated ticker; null for macro/market-wide items
  tickers          Json             @default("[]") // every ticker this story is associated with
  headline         String
  summary          String?
  source           String
  url              String?
  /// -1 (very negative) to 1 (very positive), from a deterministic keyword
  /// lexicon over the fetched headline/summary — never an invented opinion.
  sentiment        Float?
  materiality      Int // 1-10, fine-grained
  materialityLevel MaterialityLevel
  /// 0-100: how relevant this is to the CURRENT portfolio's actual exposure
  /// (holds the ticker, or the sector/topic the story covers).
  relevanceScore   Int
  /// 'live' | 'delayed' | 'mock' — reused DataQuality convention.
  quality          String           @default("mock")
  dedupeKey        String           @unique
  publishedAt      DateTime
  createdAt        DateTime         @default(now())

  @@index([symbol, publishedAt])
  @@index([materialityLevel, publishedAt])
}

/// A surfaced alert per the spec's "Alerts" section. `dedupeKey` (e.g.
/// `sec:{symbol}:{accessionNumber}`) is how monitoring jobs stay idempotent —
/// insert-if-not-exists on that key instead of re-alerting the same event
/// every time the job runs.
model Alert {
  id              String          @id @default(cuid())
  type            AlertType
  severity        AlertSeverity   @default(INFO)
  symbol          String?
  message         String
  evidence        String?
  confidenceScore Int // 1-10
  dedupeKey       String?         @unique
  createdAt       DateTime        @default(now())
  acknowledgedAt  DateTime?
  deliveries      AlertDelivery[]

  @@index([createdAt])
}

/// The single path to order placement. Every proposal starts at
/// PENDING_APPROVAL; only a human decision (or, in a future explicitly
/// enabled AUTONOMOUS mode, a policy-gated auto-approval) moves it forward.
/// Execution itself happens via the Robinhood Agentic Trading MCP
/// connector, not a stored-credential REST call — see ARCHITECTURE.md.
// ---------------------------------------------------------------------------
// Phase 2: persistent thesis engine, conviction engine, portfolio health,
// opportunity comparisons, and recommendation-outcome (performance
// attribution) tracking.
// ---------------------------------------------------------------------------

/// The living, persistent investment thesis for a holding — one row per
/// holding, updated in place as understanding evolves. It is NOT
/// regenerated from scratch on every job run: lib/jobs/generateThesis.ts
/// only rewrites these fields when the AI reasoning step + conviction
/// engine together conclude something materially changed; otherwise only
/// `lastReviewedAt` moves. The full evolution is reconstructable from
/// `changeEvents`, which are append-only and never edited.
model Thesis {
  id                    String                 @id @default(cuid())
  holdingId             String                 @unique
  holding               Holding                @relation(fields: [holdingId], references: [id])
  symbol                String
  companyOverview       String
  originalThesis        String
  growthDrivers         String
  competitiveAdvantages String
  risks                 String
  bullCase              String
  bearCase              String
  catalysts             String
  investmentHorizon     String
  /// "Why I Own This" — what would strengthen/weaken the thesis, and what
  /// would justify selling. Reviewed alongside the rest of the narrative
  /// (lib/jobs/generateThesis.ts), so these evolve the same way the thesis
  /// itself does rather than being fixed at inception.
  whatWouldStrengthen   String                 @default("Not yet assessed.")
  whatWouldWeaken       String                 @default("Not yet assessed.")
  sellConditions        String                 @default("Not yet assessed.")
  /// 0-100, mirrors the latest ConvictionAssessment.overallScore.
  convictionScore       Int
  establishedAt         DateTime               @default(now())
  lastReviewedAt        DateTime               @default(now())
  changeEvents          ThesisChangeEvent[]
  convictionAssessments ConvictionAssessment[]
  accuracyScores        ThesisAccuracyScore[]

  @@index([symbol])
}

/// Append-only log of what changed about a thesis, why, and the evidence —
/// never updated or deleted once written. This is the permanent thesis
/// history/timeline.
model ThesisChangeEvent {
  id               String           @id @default(cuid())
  thesisId         String
  thesis           Thesis           @relation(fields: [thesisId], references: [id])
  symbol           String
  changeType       ThesisChangeType
  whatChanged      String?
  whyChanged       String?
  confidenceBefore Int?
  confidenceAfter  Int?
  /// Structured evidence used to make the call (fundamentals deltas, filing
  /// references, news items, technical shifts).
  evidence         Json?
  /// Sources cited: [{type: 'filing'|'news'|'fundamentals'|'quote', ref, url?}]
  sources          Json?
  createdAt        DateTime         @default(now())

  @@index([thesisId, createdAt])
  @@index([symbol, createdAt])
}

/// One deterministic conviction scoring run for a holding. Category scores
/// are nullable — a category is only scored when real data supports it;
/// otherwise it's left null and excluded from the weighted average rather
/// than filled with a guessed number. `methodology` records exactly how
/// each score (or the decision not to score it) was reached.
model ConvictionAssessment {
  id                  String   @id @default(cuid())
  thesisId            String
  thesis              Thesis   @relation(fields: [thesisId], references: [id])
  symbol              String
  financialStrength   Int?
  revenueGrowth       Int?
  profitability       Int?
  balanceSheet        Int?
  competitiveMoat     Int?
  aiPositioning       Int?
  managementExecution Int?
  industryLeadership  Int?
  productInnovation   Int?
  valuation           Int?
  executionRisk       Int?
  regulatoryRisk      Int?
  macroSensitivity    Int?
  /// Weighted average of the categories that had real data, 0-100.
  overallScore        Int
  previousScore       Int?
  methodology         Json
  generatedAt         DateTime @default(now())

  @@index([thesisId, generatedAt])
  @@index([symbol, generatedAt])
}

/// Portfolio-level health score, tracked over time (append-only) so trend
/// can be shown. Deterministic — see lib/domain/portfolioHealth.ts.
model PortfolioHealthAssessment {
  id                   String   @id @default(cuid())
  diversificationScore Int
  qualityScore         Int
  growthScore          Int
  riskScore            Int
  valuationScore       Int
  sectorBalanceScore   Int
  cashAllocationScore  Int
  concentrationScore   Int
  macroExposureScore   Int
  overallScore         Int
  previousScore        Int?
  componentBreakdown   Json
  topImprovements      Json
  topConcerns          Json
  generatedAt          DateTime @default(now())

  @@index([generatedAt])
}

/// Evidence-based comparison of a not-yet-held Opportunity against the most
/// relevant current holding — never "replace because trending."
model OpportunityComparison {
  id               String         @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity    @relation(fields: [opportunityId], references: [id])
  comparedToSymbol String
  metrics          Json
  narrative        String
  overallEdge      ComparisonEdge
  generatedAt      DateTime       @default(now())

  @@index([opportunityId, generatedAt])
}

/// Performance attribution for a single Recommendation. Price/SPY levels
/// are captured once at recommendation time; return/alpha columns fill in
/// as each time window actually elapses — there is no way to backfill a
/// 365-day return before 365 days have passed, so these are legitimately
/// null until then rather than estimated. Because Atlas never executes
/// trades, "outcome" and "what happens if you take no action" are the same
/// realized price path — there's no alternate universe to compare against,
/// so alpha vs. SPY is the primary value-add signal.
model RecommendationOutcome {
  id                    String            @id @default(cuid())
  recommendationId      String            @unique
  recommendation        Recommendation    @relation(fields: [recommendationId], references: [id])
  symbol                String
  action                RecommendedAction
  confidenceScore       Int
  recommendedAt         DateTime
  priceAtRecommendation Decimal
  sp500AtRecommendation Decimal
  return1d              Float?
  return7d              Float?
  return30d             Float?
  return90d             Float?
  return180d            Float?
  return365d            Float?
  sp500Return1d         Float?
  sp500Return7d         Float?
  sp500Return30d        Float?
  sp500Return90d        Float?
  sp500Return180d       Float?
  sp500Return365d       Float?
  alpha1d               Float?
  alpha7d               Float?
  alpha30d              Float?
  alpha90d              Float?
  alpha180d             Float?
  alpha365d             Float?
  lastEvaluatedAt       DateTime          @default(now())
  /// --- Recommendation Learning Engine (Phase 3) ---
  /// A single retrospective critique pass, written once enough time has
  /// elapsed (see lib/jobs/evaluateRecommendations.ts) and then left
  /// alone — Atlas grades a call exactly once per elapsed window it
  /// evaluates, it does not keep re-litigating the same recommendation.
  wasCorrect            Boolean?
  thesisCorrect         Boolean?
  timingCorrect         Boolean?
  assumptionsValidated  Json?
  assumptionsFailed     Json?
  missingEvidence       String?
  lessonsLearned        String?
  criticalReviewedAt    DateTime?

  @@index([symbol])
}

// ---------------------------------------------------------------------------
// Phase 3A: institutional data foundation — fundamentals history, valuation
// history, ownership history, and a real forward earnings calendar, all from
// a connected fundamentals vendor (Financial Modeling Prep). Every field is
// nullable and independently sourced; nothing here is ever back-filled with
// a guess when the vendor doesn't return a value.
// ---------------------------------------------------------------------------

/// One reported (or restated) financial-statement period for a symbol.
/// Raw statement line items are kept as JSON (income/balance/cashFlow) for
/// completeness, while the metrics the conviction/health engines actually
/// consume are promoted to typed columns so trend queries don't need to
/// parse JSON. Upserted by its natural key — a restatement updates the same
/// row rather than creating a duplicate period.
model FundamentalSnapshot {
  id              String              @id @default(cuid())
  symbol          String
  periodType      StatementPeriodType
  fiscalYear      Int
  fiscalPeriod    String // "FY" for annual, "Q1".."Q4" for quarterly
  reportDate      DateTime
  income          Json
  balance         Json
  cashFlow        Json
  revenue         Float?
  revenueGrowth   Float? // YoY, decimal (0.15 = +15%)
  grossMargin     Float?
  operatingMargin Float?
  netMargin       Float?
  freeCashFlow    Float?
  eps             Float?
  epsGrowth       Float?
  roe             Float?
  roic            Float?
  debtToEquity    Float?
  currentRatio    Float?
  cash            Float?
  totalDebt       Float?
  quality         String              @default("mock")
  source          String              @default("mock")
  createdAt       DateTime            @default(now())

  @@unique([symbol, periodType, fiscalYear, fiscalPeriod])
  @@index([symbol, reportDate])
}

/// Point-in-time valuation multiples — appended on a freshness window (not
/// upserted) since these move with price, unlike statement data.
model ValuationSnapshot {
  id          String   @id @default(cuid())
  symbol      String
  peRatio     Float?
  forwardPe   Float?
  peg         Float?
  evToEbitda  Float?
  evToSales   Float?
  priceToBook Float?
  priceToFcf  Float?
  quality     String   @default("mock")
  asOf        DateTime @default(now())

  @@index([symbol, asOf])
}

/// Ownership/share-count snapshot — insider %, institutional %, share count
/// and its change (negative = buybacks, positive = dilution), dividend data.
model OwnershipSnapshot {
  id                         String   @id @default(cuid())
  symbol                     String
  insiderOwnershipPct        Float?
  institutionalOwnershipPct  Float?
  sharesOutstanding          Float?
  sharesOutstandingChangePct Float?
  dividendPerShare           Float?
  dividendYield              Float?
  quality                    String   @default("mock")
  asOf                       DateTime @default(now())

  @@index([symbol, asOf])
}

/// A single fiscal-period earnings event — starts as an estimate
/// (isEstimate=true) and is updated in place as the actual report lands.
/// `estimateRevisions` appends an entry every time a re-fetch finds the
/// street estimate has moved, so revision history is preserved even though
/// the row itself is mutable (this is the one place in the schema where
/// "update in place" is the correct model, not append-only — an earnings
/// date is one real-world event, not a time series).
model EarningsEvent {
  id                 String    @id @default(cuid())
  symbol             String
  fiscalYear         Int
  fiscalPeriod       String
  reportDate         DateTime
  isEstimate         Boolean   @default(true)
  epsEstimate        Float?
  epsActual          Float?
  epsSurprisePct     Float?
  revenueEstimate    Float?
  revenueActual      Float?
  revenueSurprisePct Float?
  guidanceNote       String?
  callDate           DateTime?
  estimateRevisions  Json      @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([symbol, fiscalYear, fiscalPeriod])
  @@index([symbol, reportDate])
}

// ---------------------------------------------------------------------------
// Phase 3A: alert delivery layer. The alert engine (lib/domain/alerts.ts,
// createAlertIfNew) is completely unaware this exists — delivery is a
// separate sweep over Alert rows, so adding a channel type later (Slack,
// Discord, SMS, mobile push) never touches alert generation.
// ---------------------------------------------------------------------------

/// A configured delivery channel. `config` shape depends on `type`: EMAIL
/// stores {to}, WEBHOOK stores {url, secret?}. One row per type for now
/// (see lib/integrations/notifications.ts) — supporting several channels of
/// the same type is a trivial follow-up (drop the unique constraint).
model NotificationChannel {
  id        String                  @id @default(cuid())
  type      NotificationChannelType @unique
  config    Json
  enabled   Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  deliveries AlertDelivery[]
}

/// One delivery attempt record per (alert, channel) — the unique constraint
/// is what makes the delivery job idempotent (create-and-catch-P2002, same
/// pattern as everywhere else), and failed deliveries are retried in place
/// (status flips back to PENDING/FAILED, attempts increments) rather than
/// creating a second row for the same alert+channel pair.
model AlertDelivery {
  id          String              @id @default(cuid())
  alertId     String
  alert       Alert               @relation(fields: [alertId], references: [id])
  channelId   String
  channel     NotificationChannel @relation(fields: [channelId], references: [id])
  status      DeliveryStatus      @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())

  @@unique([alertId, channelId])
}

// ---------------------------------------------------------------------------
// Phase 3B: continuous learning. Every score here is a deterministic
// calculation over Recommendation/RecommendationOutcome/ConvictionAssessment/
// Thesis history — the retrospective judgment calls (wasCorrect etc., above
// on RecommendationOutcome) are the deterministic inputs; these models
// aggregate them. Small-sample results are labeled, never dressed up as
// statistically meaningful when they aren't.
// ---------------------------------------------------------------------------

/// Append-only calibration run: buckets recommendations by their stated
/// confidenceScore (1-10, treated as decile confidence bands) and compares
/// against actual win rate in that band. overallBrierScore is a real
/// statistical calibration metric (mean squared error of predicted
/// probability vs. binary outcome) — lower is better calibrated.
model ConfidenceCalibration {
  id                String   @id @default(cuid())
  buckets           Json
  overallBrierScore Float?
  sampleSize        Int
  methodology       Json
  generatedAt       DateTime @default(now())

  @@index([generatedAt])
}

/// Retrospective accuracy scoring for a thesis — how well its narrative
/// held up against what actually happened, per component. Components with
/// no deterministic formula (e.g. "were the stated catalysts achieved") are
/// left null and documented rather than estimated from free text.
model ThesisAccuracyScore {
  id                   String   @id @default(cuid())
  thesisId             String
  thesis               Thesis   @relation(fields: [thesisId], references: [id])
  symbol               String
  revenueAccuracy      Int?
  marginAccuracy       Int?
  catalystsAchievedPct Float?
  risksRealizedPct     Float?
  valuationAccuracy    Int?
  timingAccuracy       Int?
  overallScore         Int
  methodology          Json
  generatedAt          DateTime @default(now())

  @@index([thesisId, generatedAt])
  @@index([symbol, generatedAt])
}

/// Permanent, append-only scorecard snapshot — Atlas measuring its own
/// effectiveness. A time series (like RiskAssessment/PortfolioHealthAssessment)
/// so the scorecard itself can show a trend, not just a single number.
model RecommendationScorecard {
  id                   String   @id @default(cuid())
  totalRecommendations Int
  buyCount             Int
  holdCount            Int
  reduceCount          Int
  sellCount            Int
  watchCount           Int
  winRatePct           Float?
  falsePositives       Int
  falseNegatives       Int
  alphaVsSpyAvgPct     Float?
  avgHoldingPeriodDays Float?
  /// Average alpha90d across losing outcomes only (a drawdown proxy — see
  /// "Why avgDrawdownPct isn't a real peak-to-trough measure" in
  /// computeScorecard.ts). Positive number = average pain, not a raw delta.
  avgDrawdownPct       Float?
  /// Average alpha90d across winning outcomes only.
  avgGainPct           Float?
  /// % of recommendations with any userDecision other than PENDING —
  /// "did the user engage with this at all."
  utilizationPct       Float?
  /// % of decided (non-PENDING) recommendations that were ACCEPTED or
  /// PARTIALLY_ACCEPTED.
  acceptanceRatePct    Float?
  methodology          Json
  generatedAt          DateTime @default(now())

  @@index([generatedAt])
}

/// A statistically-gated pattern found across historical recommendations
/// (e.g. "holdings in sector X outperformed SPY by Y pp, n=Z"). Only
/// surfaced when sampleSize clears a minimum threshold — see
/// lib/jobs/detectPatterns.ts — so this never asserts a pattern from a
/// handful of coincidental data points.
model RecommendationPattern {
  id                String            @id @default(cuid())
  label             String
  description       String
  sampleSize        Int
  supportingSymbols Json
  winRatePct        Float?
  confidenceLevel   PatternConfidence
  methodology       Json
  generatedAt       DateTime          @default(now())

  @@index([generatedAt])
}

// ---------------------------------------------------------------------------
// Phase 3.5: live-evaluation sync. An agent session with the Robinhood
// Agentic Trading MCP connector active reads real account state and reports
// it to lib/domain/accountSync.ts (via the CLI or the /api/sync/account
// route) — this app never holds brokerage credentials, MCP tokens, or
// session secrets; see lib/integrations/robinhood.ts and ARCHITECTURE.md.
// ---------------------------------------------------------------------------

/// A brokerage-reported open (unfilled) order — mirror-only, never written
/// to by this app. Upserted by (accountId, externalId); Atlas has no
/// execution visibility beyond what a sync payload reports, so a stale row
/// isn't auto-closed — its `status` reflects what was last reported.
model OpenOrder {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  externalId  String // brokerage order id
  symbol      String
  side        TradeSide
  quantity    Decimal
  orderType   OrderType
  limitPrice  Decimal?
  stopPrice   Decimal?
  status      String // brokerage's own vocabulary (e.g. "open", "partially_filled") — not normalized into an enum
  submittedAt DateTime
  lastSeenAt  DateTime  @updatedAt

  @@unique([accountId, externalId])
  @@index([symbol])
}

/// Audit log for every account-sync attempt, successful or not — the
/// permanent record of "what synced, from where, when, and what happened."
model SyncLog {
  id                    String    @id @default(cuid())
  accountId             String?
  account               Account?  @relation(fields: [accountId], references: [id])
  source                String // e.g. "cli", "api"
  schemaVersion         String
  payloadAsOf           DateTime?
  success               Boolean
  recordsAdded          Int       @default(0)
  recordsUpdated        Int       @default(0)
  recordsSkipped        Int       @default(0)
  errors                Json      @default("[]")
  warnings              Json      @default("[]")
  /// Structured field-by-field Atlas-vs-Robinhood comparison (Phase 3.7) —
  /// see lib/domain/accountSync.ts ReconciliationDetail. `warnings` above
  /// stays free-text for backward compatibility; this is the same
  /// comparisons, machine-readable, consumed by scripts/validateFirstSync.ts.
  reconciliationDetails Json      @default("[]")
  syncedAt              DateTime  @default(now())

  @@index([syncedAt])
  @@index([accountId, syncedAt])
}

// ---------------------------------------------------------------------------
// Phase 3.6: production-readiness / trust layer — provider health telemetry
// backing failure-recovery (retries, never-silently-fail) and the data-
// freshness snapshot shown beside every recommendation.
// ---------------------------------------------------------------------------

/// One real-provider call attempt (market data, news, fundamentals, SEC
/// filings, AI reasoning) — never the payload itself, just health
/// telemetry: did it succeed, how long did it take, did it fall back to
/// mock. lib/domain/dataFreshness.ts reads the recent window of these per
/// provider to compute reliability % and average latency; retries recorded
/// by lib/integrations/retry.ts. Not indefinitely retained — see
/// pruneOldProviderCallLogs in lib/domain/dataFreshness.ts.
model ProviderCallLog {
  id        String              @id @default(cuid())
  provider  String // e.g. "twelvedata", "finnhub", "financialmodelingprep", "sec-edgar", "claude"
  operation String // e.g. "getQuote", "getNewsForSymbol"
  outcome   ProviderCallOutcome
  latencyMs Int
  error     String?
  calledAt  DateTime            @default(now())

  @@index([provider, calledAt])
}

// ---------------------------------------------------------------------------
// Phase 3.7: live validation & operational readiness. ManualExecution is
// purely a record of what the user already did in Robinhood — nothing here
// (or anywhere else in this schema) represents an order Atlas can submit,
// preview, cancel, or modify. DataQualityGateLog is the audit trail for the
// gate that runs before every recommendation, including attempts it
// blocked. SchedulerRun/SchedulerLock/SchedulerJobConfig back the local
// operational scheduler (lib/domain/scheduler.ts) that replaces
// reliance on Vercel Cron for MacBook use.
// ---------------------------------------------------------------------------

/// A trade the user manually executed themselves (in Robinhood or
/// elsewhere) and is reporting to Atlas for record-keeping — recording one
/// of these NEVER triggers, previews, or otherwise causes a trade. The next
/// Robinhood sync's post-sync pipeline step
/// (lib/domain/executionReconciliation.ts) attempts to match it against a
/// real synced Transaction using configurable tolerances and records how
/// well they line up in `matchStatus`.
model ManualExecution {
  id                   String               @id @default(cuid())
  accountId            String
  account              Account              @relation(fields: [accountId], references: [id])
  symbol               String
  side                 TradeSide
  executedAt           DateTime
  quantity             Decimal
  dollarAmount         Decimal
  executionPrice       Decimal
  fees                 Decimal              @default(0)
  note                 String?
  recommendationId     String?
  recommendation       Recommendation?      @relation(fields: [recommendationId], references: [id])
  matchStatus          ExecutionMatchStatus @default(PENDING)
  matchedTransactionId String?              @unique
  matchedTransaction   Transaction?         @relation(fields: [matchedTransactionId], references: [id])
  reconciledAt         DateTime?
  reconciliationNote   String?
  recordedAt           DateTime             @default(now())

  @@index([accountId, symbol])
  @@index([matchStatus])
}

/// Audit trail of every data-quality gate evaluation
/// (lib/domain/dataQualityGate.ts) — including BLOCKED ones, which are the
/// only record such an attempt leaves, since a blocked evaluation
/// deliberately produces no Recommendation row rather than a fabricated
/// one. PASS/PASS_WITH_WARNINGS evaluations are also denormalized onto the
/// Recommendation row itself (dataQualityStatus/dataQualityChecks) for
/// fast display; this table is the append-only history, including blocks.
model DataQualityGateLog {
  id        String            @id @default(cuid())
  symbol    String
  accountId String?
  status    DataQualityStatus
  checks    Json
  checkedAt DateTime          @default(now())

  @@index([symbol, checkedAt])
  @@index([status])
}

/// One row per scheduler job execution attempt — the run history required
/// by the local operational scheduler (lib/domain/scheduler.ts,
/// scripts/scheduler.ts). Distinct from SyncLog (account-sync-specific
/// audit) and the ad hoc {ok,result,errors} JSON each /api/jobs/* route
/// returns today — this is the first durable, queryable record of "did job
/// X run, when, how long, with what result," across every job in the app.
model SchedulerRun {
  id         String             @id @default(cuid())
  jobName    String
  status     SchedulerRunStatus @default(RUNNING)
  trigger    String // "scheduled" | "manual"
  attempt    Int                @default(1)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  durationMs Int?
  result     Json?
  error      String?
  warnings   Json               @default("[]")

  @@index([jobName, startedAt])
  @@index([status])
}

/// Lease-based lock preventing two overlapping runs of the same job — held
/// only while that job is actually running, with an expiry so a
/// crashed/killed process (e.g. the MacBook slept mid-run) can't
/// permanently wedge future runs of that job.
model SchedulerLock {
  jobName    String   @id
  lockedAt   DateTime @default(now())
  leaseUntil DateTime
  holder     String // hostname:pid, informational only

  @@index([leaseUntil])
}

/// Per-job enabled/disabled flag, toggleable from the CLI and visible on
/// the ops dashboard. A disabled job's scheduled runs are skipped (recorded
/// in SchedulerRun with status SKIPPED) rather than silently not happening.
model SchedulerJobConfig {
  jobName   String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Atlas OS v1 — product layer (authentication + Atlas Chat). These models are
// additive only: nothing above this line (Atlas Core — recommendation
// engine, thesis engine, learning engine, provider validation, Robinhood
// sync, scheduler, trust layer, execution boundary, data-quality gates) is
// modified. Atlas OS orchestrates Atlas Core; it never re-implements it.
// ---------------------------------------------------------------------------

/// Single-admin (today) credential store for the hand-rolled session-cookie
/// auth in lib/auth/session.ts — no OAuth, no next-auth. Sessions are
/// stateless signed JWTs (see AUTH_SECRET), so this table isn't read on every
/// request, only at login; `id` is embedded in the JWT `sub` claim.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  conversations Conversation[]
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

/// One Atlas Chat thread. `title` is derived from the first user message
/// (truncated) at creation time — never re-summarized by an extra AI call.
model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

/// One turn in a conversation. `toolCalls` records which Atlas Core services
/// an ASSISTANT turn invoked (name/input/result) — an audit trail proving
/// answers came from real tool calls, not from the model's own memory.
model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String       @db.Text
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// The five canonical intervals the Live Market Data & Charting Layer
/// supports today (see lib/marketdata/types.ts). Deliberately a closed enum
/// rather than a free string so a typo can never silently create a new,
/// uncached interval bucket — adding a new interval is a migration, exactly
/// as visible as it should be.
enum CandleInterval {
  MIN30
  HOUR1
  HOUR4
  DAY1
  WEEK1
}

/// Mirrors lib/marketdata/types.ts's FreshnessStatus — how trustworthy/
/// current this candle was when stored. A cached completed candle keeps
/// whatever freshness it was fetched with; only the in-progress candle for
/// "now" is ever re-fetched and overwritten.
enum CandleFreshness {
  LIVE
  DELAYED
  END_OF_DAY
  CACHED
  STALE
  UNAVAILABLE
}

enum MarketSessionType {
  REGULAR
  PRE_MARKET
  AFTER_HOURS
  CLOSED
}

/// The shared OHLCV cache every surface (charts, technical evidence,
/// supply/demand, liquidity, monitoring, alerts, Atlas Chat) reads through
/// via lib/domain/candles.ts — never re-fetched from the provider once a
/// candle is complete. `isActive` marks the current in-progress candle for
/// an interval (there is at most one per symbol+interval at a time), which
/// is always treated as mutable and safe to overwrite in place; every other
/// row is immutable once written. `timestamp` is the candle's OPEN time in
/// UTC (the exchange-local session context is derived, not stored per row,
/// from lib/marketdata/sessions.ts to avoid drift between the two).
model PriceCandle {
  id              String            @id @default(cuid())
  symbol          String
  interval        CandleInterval
  timestamp       DateTime
  open            Decimal
  high            Decimal
  low             Decimal
  close           Decimal
  volume          BigInt
  sessionType     MarketSessionType @default(REGULAR)
  provider        String
  receivedAt      DateTime          @default(now())
  freshness       CandleFreshness
  adjusted        Boolean           @default(false)
  splitAdjustment Json?
  isActive        Boolean           @default(false)

  @@unique([symbol, interval, timestamp])
  @@index([symbol, interval, timestamp])
  @@index([symbol, interval, isActive])
}
