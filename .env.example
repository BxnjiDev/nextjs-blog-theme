# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/atlas?schema=public"

# --- Integrations (all optional; app falls back to mock/heuristic providers when unset) ---

# Market data provider (Twelve Data — https://twelvedata.com). Free tier covers
# quotes, historical daily prices, and fundamentals. Falls back to clearly-fake
# mock data when unset, and falls back per-call if a configured key errors out.
MARKET_DATA_API_KEY=

# Financial news provider (Finnhub — https://finnhub.io). Free tier covers
# company news, general market news, and (via sector-proxy ETF tickers,
# documented in lib/integrations/news.ts) AI/semiconductor/defense/aerospace/
# robotics/data-center/energy/cybersecurity coverage. Sentiment and
# materiality are computed deterministically from the real fetched text
# (lib/integrations/newsScoring.ts) — never invented. Falls back to an empty
# feed (never fabricated headlines) when unset or on a failed call.
NEWS_API_KEY=

# SEC EDGAR uses no API key (public full-text search API) but a contact email
# is required in the User-Agent header per SEC's fair-access policy.
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"

# Claude API key for the recommendation-generation job's AI reasoning step.
# Without this, recommendations fall back to a deterministic, clearly-labeled
# data summary instead of real analysis.
ANTHROPIC_API_KEY=

# Which Claude model to use for AI reasoning. Optional — defaults to
# claude-opus-4-8. Validated at startup against the model IDs the installed
# @anthropic-ai/sdk version recognizes (see lib/integrations/anthropicModel.ts);
# an unsupported value fails immediately with a clear error instead of a
# confusing failure deep in a background job. Only checked when
# ANTHROPIC_API_KEY is set. Supported values as of the installed SDK
# (0.111.0): claude-opus-4-8, claude-opus-4-7, claude-opus-4-6, claude-opus-4-5,
# claude-opus-4-1, claude-sonnet-5, claude-sonnet-4-6, claude-sonnet-4-5,
# claude-haiku-4-5, claude-fable-5, claude-mythos-5, claude-mythos-preview
# (plus their dated-snapshot variants).
ANTHROPIC_MODEL=

# Shared secret the /api/jobs/* routes require as `Authorization: Bearer
# <value>`. Vercel Cron sends this header automatically once CRON_SECRET is
# set as a project env var. Routes refuse to run at all if this is unset.
CRON_SECRET=

# Robinhood Agentic Trading is connected as an MCP server, not an env-var
# credential — see ARCHITECTURE.md. Nothing to set here.
