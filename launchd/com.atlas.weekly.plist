<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.atlas.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/nextjs-blog-theme/node_modules/.bin/tsx</string>
    <string>scripts/scheduler.ts</string>
    <string>run</string>
    <string>weeklyLearning</string>
    <string>--scheduled</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/nextjs-blog-theme</string>

  <!-- Sunday mornings at 9:00 AM, matching vercel.json's weekly learning cadence. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/nextjs-blog-theme/logs/scheduler-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/nextjs-blog-theme/logs/scheduler-weekly.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
